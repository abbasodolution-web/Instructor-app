<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_error_practice_ticket_tree" model="ir.ui.view">
        <field name="name">error.practice.ticket.tree</field>
        <field name="model">error.practice.ticket</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="expected_hours"/>
                <field name="spent_hours"/>
                <field name="remaining_hours"/>
            </tree>
        </field>
    </record>

    <record id="view_error_practice_ticket_form" model="ir.ui.view">
        <field name="name">error.practice.ticket.form</field>
        <field name="model">error.practice.ticket</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Error 5: this button method does not exist in Python. -->
                    <button name="action_start" type="object" string="Start" class="btn-primary"
                            states="draft"/>
                    <button name="action_done" type="object" string="Done"
                            states="in_progress"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="priority"/>
                            <!-- Error 2: field does not exist in Python model. -->
                            <field name="assigned_user_id"/>
                        </group>
                        <group>
                            <field name="expected_hours"/>
                            <field name="spent_hours"/>
                            <field name="remaining_hours"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_error_practice_ticket" model="ir.actions.act_window">
        <field name="name">Practice Tickets</field>
        <field name="res_model">error.practice.ticket</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first practice ticket</p>
        </field>
    </record>
</odoo>
