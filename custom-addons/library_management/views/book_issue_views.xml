<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_library_issue_tree" model="ir.ui.view">
        <field name="name">library.book.issue.tree</field>
        <field name="model">library.book.issue</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="member_id"/>
                <field name="book_id"/>
                <field name="issue_date"/>
                <field name="due_date"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_library_issue_form" model="ir.ui.view">
        <field name="name">library.book.issue.form</field>
        <field name="model">library.book.issue</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar" options = "{'clickable': '1'}" statusbar_visible="draft,issued,returned"/>
                    <button
                        name="action_return_book"
                        string="Return Book"
                        type="object"
                        class="btn-primary"
                        invisible="status == 'returned'"/>
    
                    <button
                        name="action_issue_book"
                        string="Issue Book"
                        type="object"
                        class="btn-primary"
                        invisible="status == 'issued'"/>
                </header>
                <sheet>
                    <group>
                        
                        <field name="name" readonly="1"/>
                        <field name="member_id" readonly="status == 'confirmed'"/>
                        <field name="book_id" readonly="status == 'confirmed'"/>
                        <field name="issue_date" readonly="status == 'confirmed'"/>
                        <field name="due_date" readonly="status == 'confirmed'"/>
                        <field name="return_date" readonly="status == 'confirmed'"/>
                        <field name="status" readonly="1"/>
                    </group>
                    <group>
                        <button name="action_open_confirm_wizard"
                                string="Confirm"
                                type="object"
                                class="btn-primary"
                                invisible="status != 'draft'"/>
                    </group>
                    <!-- <notebook>
                        <page string="Issue Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="book_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook> -->

                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

</odoo>