<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_library_issue_tree" model="ir.ui.view">
        <field name="name">library.book.issue.tree</field>
        <field name="model">library.book.issue</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="member_id"/>
                <field name="book_id"/>
                <field name="issue_date"/>
                <field name="due_date"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_library_issue_form" model="ir.ui.view">
        <field name="name">library.book.issue.form</field>
        <field name="model">library.book.issue</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_return_book"
                        string="Return Book"
                        type="object"
                        class="btn-primary"
                        invisible="status == 'returned'"/>
                </header>
                <sheet>
                    <group>
                        
                        <field name="name" readonly="1"/>
                        <field name="member_id"/>
                        <field name="book_id"/>
                        <field name="issue_date"/>
                        <field name="due_date"/>
                        <field name="return_date"/>
                        <field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>