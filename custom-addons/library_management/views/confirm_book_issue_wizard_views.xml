<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_confirm_book_issue_wizard_form" model="ir.ui.view">
        <field name="name">confirm.book.issue.wizard.form</field>
        <field name="model">confirm.book.issue.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Book Issue">
                <group>
                    <field name="book_issue_id" invisible="1"/>
                    <field name="member_id"/>
                    <field name="book_id"/>
                    <field name="issue_date"/>
                    <field name="due_date"/>
                </group>

                <footer>
                    <button name="action_validate"
                            string="Validate"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>