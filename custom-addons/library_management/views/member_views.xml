<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_library_member_tree" model="ir.ui.view">
        <field name="name">library.member.tree</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="member_name"/>
                <field name="phone"/>
                <field name="membership_type"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_library_member_form" model="ir.ui.view">
        <field name="name">library.member.form</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_issue_wizard"
                            string="Issue Book"
                            type="object"
                            class="btn-primary"/>

                    <button name="action_view_book_issues"
                            string="View Book Issues"
                            type="object"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="member_name"/>
                        <field name="email"/>
                        <field name="phone"/>
                        <field name="address"/>
                        <field name="membership_date"/>
                        <field name="membership_type"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Book Issue History">
                            <field name="book_issue_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="book_names"/>
                                    <field name="book_id"/>
                                    <field name="issue_date"/>
                                    <field name="due_date"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>