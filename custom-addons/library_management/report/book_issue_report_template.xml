<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_book_issue_pdf">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 style="text-align:center; margin-bottom:20px;">
                        Library Book Issue Report
                    </h2>

                    <p>
                        <strong>Start Date:</strong>
                        <span t-esc="docs.start_date"/>
                        <br/>
                        <strong>End Date:</strong>
                        <span t-esc="docs.end_date"/>
                    </p>

                    <table class="table table-sm table-bordered" style="width:100%; border-collapse:collapse;">
                        <thead>
                            <tr>
                                <th>Member ID</th>
                                <th>Member Name</th>
                                <th>Email</th>
                                <th>Issue ID</th>
                                <th>Book Name</th>
                                <th>Issue Date</th>
                                <th>Due Date</th>
                                <th>Return Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="report_data" t-as="line">
                                <tr>
                                    <td><span t-esc="line['member_id']"/></td>
                                    <td><span t-esc="line['member_name']"/></td>
                                    <td><span t-esc="line['member_email']"/></td>
                                    <td><span t-esc="line['issue_id']"/></td>
                                    <td><span t-esc="line['book_names']"/></td>
                                    <td><span t-esc="line['issue_date']"/></td>
                                    <td><span t-esc="line['due_date']"/></td>
                                    <td><span t-esc="line['return_date']"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

</odoo>