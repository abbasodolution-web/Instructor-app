<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_book_issue_report_wizard_form" model="ir.ui.view">
        <field name="name">book.issue.report.wizard.form</field>
        <field name="model">book.issue.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Book Issue Report">
                <group>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </group>

                <footer>
                    <button name="action_print_pdf"
                            string="Print PDF"
                            type="object"
                            class="btn-primary"/>

                    <button name="action_print_excel"
                            string="Print Excel"
                            type="object"/>

                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_book_issue_report_wizard" model="ir.actions.act_window">
        <field name="name">Book Issue Report</field>
        <field name="res_model">book.issue.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>