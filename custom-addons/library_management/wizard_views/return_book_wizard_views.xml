<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_return_book_wizard_form" model="ir.ui.view">
        <field name="name">return.book.wizard.form</field>
        <field name="model">return.book.wizard</field>
        <field name="arch" type="xml">
            <form string="Return Book">
                <group>
                    <field name="return_date"/>
                    <field name="remarks"/>
                    <field name="book_issue_id" invisible="1"/>
                </group>

                <footer>
                    <button string="Confirm"
                            name="action_confirm"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>