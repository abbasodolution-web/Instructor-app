<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">

        <!-- Book Sequence -->
        <record id="seq_library_book" model="ir.sequence">
            <field name="name">Book Sequence</field>
            <field name="code">library.book</field>
            <field name="prefix">BK/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Member Sequence -->
        <record id="seq_library_member" model="ir.sequence">
            <field name="name">Member Sequence</field>
            <field name="code">library.member</field>
            <field name="prefix">MB/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Book Issue Sequence -->
        <record id="seq_library_issue" model="ir.sequence">
            <field name="name">Book Issue Sequence</field>
            <field name="code">library.book.issue</field>
            <field name="prefix">IS/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

    </data>

</odoo>