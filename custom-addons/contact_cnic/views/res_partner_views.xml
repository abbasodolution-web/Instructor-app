<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Add CNIC field to Contact form view -->
        <record id="view_partner_form_inherit_cnic" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.cnic</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <!-- Using structured xpath to target the 'vat' field safely -->
                <xpath expr="//field[@name='vat']" position="after">
                    <field name="cnic" placeholder="e.g. 12345-1234567-1"/>
                </xpath>
            </field>
        </record>

        <!-- Add CNIC as a searchable filterable column in list view -->
        <record id="view_partner_tree_inherit_cnic" model="ir.ui.view">
            <field name="name">res.partner.tree.inherit.cnic</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_tree"/>
            <field name="arch" type="xml">
                <!-- Changed 'name' to 'display_name' to match core Odoo list view -->
                <xpath expr="//field[@name='display_name']" position="after">
                    <field name="cnic"/>
                </xpath>
            </field>
        </record>

        <!-- Allow searching contacts by CNIC -->
        <record id="view_res_partner_filter_inherit_cnic" model="ir.ui.view">
            <field name="name">res.partner.search.inherit.cnic</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_res_partner_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='vat']" position="after">
                    <field name="cnic" string="CNIC"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
