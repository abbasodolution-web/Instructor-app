<?xml version="1.0" encoding="utf-8"?>
<odoo>


<!-- This is the tree view for patient. -->
<record id = "view_hospital_patient_tree" model = "ir.ui.view">
    <field name = "name">hospital.patient.tree</field>
    <field name = "model">hospital.patient</field>
    <field name = "arch" type = "xml">
        <tree>
            <field name = "name" string = "Patient Name"/>
            <field name = "age" string = "Patient Age"/>
            <field name = "gender" string = "Patient Gender"/>
            <field name = "code" string = "Patient Code"/>
            <field name = "date_of_birth" string = "Date of Birth"/>

        </tree>
    </field>
</record>


<!-- This is the form view for patient -->
<record  id = "view_hospital_patient_form" model = "ir.ui.view">
    <field name = "name">hospital.patient.form</field>
    <field name = "model">hospital.patient</field>
    <field name =  "arch" type = "xml">
        <form>
            <sheet>
                <group>
                    <group>
                        <field name = "name"/>
                        <field name = "date_of_birth"/>
                        <field name = "active" invisible = "1"/>
                    </group>
                </group>
                <notebook>
                    <page string = "General">
                        <group>
                            <field name = "age"/>
                            <field name = "gender"/>
                            <field name="blood_group"/>
                            <field name = "code" string = "Patient Code"/>
                        </group>
                    </page>

                    <page string = "Contact">
                        <group>
                            <field name = "phone"/>
                            <field name = "email"/>
                        </group>
                    </page>

                    <page string = "Notes">
                        <group>
                            <field name = "notes"/>
                        </group>
                    </page>
                </notebook>
            </sheet>

<!--                 
                    <group>
                        <field name = "gender"/>
                    </group>
                </group> -->
            <div class = "oe_chatter">
                <field name = "message_follower_ids" group = "base.group_user"/>
                <field name = "activity_ids"/>
                <field name = "message_ids"/>
            </div>
        </form>
    </field>
</record>

<!-- This is the search view for patient -->
<record id = "view_hospital_patient_search" model = "ir.ui.view">
    <field name = "name">hospital.patient.search</field>
    <field name = "model">hospital.patient</field>
    <field name = "arch" type = "xml">
        <search>
            <field name = "name" filter_domain = "['|',('name','ilike',self),('code','ilike',self)]"/>
            <field name = "age"/>
            <field name = "gender"/>
            <field name = "code"/>
            <filter name = "filter_male" string = "Male" domain = "[('gender','=','male')]"/>
            <filter name = "filter_female" string = "Female" domain = "[('gender','=','female')]"/>
            <separator/>
            <filter name = "filter_kids" string = "Kids" domain = "[('age','&lt;=',14)]"/>
            <separator/>
            <filter name = 'Archived' string = "Archived" domain = "[('active','=',False)]"/>
            <group expand = "0" string ="Group By">
                <filter string = "Gender" name = "group_by_gender" context = "{'group_by':'gender'}"/>
            </group>
        </search>
    </field>
</record>


<!-- This is action for patient -->
    <record id = "action_hopital_patient" model = "ir.actions.act_window">
    <field name = "name">Patients</field>
    <field name = "type">ir.actions.act_window</field>
    <field name = "res_model">hospital.patient</field>
    <field name = "view_mode">tree,form</field>
    <field name = "context">{}</field>
    <field name = "help" type = "html">
        <p class = "o_view_nocontent_smiling_face">
            Create your first patient.
        </p>
    </field>
    </record>

<!-- This is the menu for patient -->
    <menuitem id = "menu_patient"
                    name = "Patients"
                    action = "action_hopital_patient"
                    parent = "menu_patient_master"
                    sequence = "0"/>
</odoo>